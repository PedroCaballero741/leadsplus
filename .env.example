# Copy this file to .env and fill in your key. Never commit .env.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
SENDER_NAME=Antonio Madera
# SENDER_COMPANY=Your Company
# SENDER_PITCH=One or two sentences describing what you sell and the result it delivers.

# --- Lead discovery (real businesses only; configure at least one) ---
# Google Places API (New): best coverage. Enable "Places API (New)" in Google Cloud.
# GOOGLE_PLACES_API_KEY=
# Foursquare Places API service key: https://foursquare.com/developers
# FOURSQUARE_API_KEY=
# Order/selection of providers. OpenStreetMap ("osm") needs no key but has sparse coverage.
DISCOVERY_PROVIDERS=google,foursquare,osm
# Identify yourself to OpenStreetMap services (their usage policy requires a contact).
# DISCOVERY_USER_AGENT=LeadHarvester/1.0 (contact: you@yourdomain.com)
